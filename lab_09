university=# -- Designing a Library Management System
university=# -- Entities: Book, Author, Member, Loan
university=# -- Relationships:
university=# -- Author writes book (many_to_many)
university=# -- Member borrows book through Loan (one_to_many)
university=# CREATE TABLE authors (
university(# author_id SERIAL PRIMARY KEY,
university(# first_name VARCHAR(50) NOT NULL,
university(# last_name VARCHAR(50) NOT NULL,
university(# birth_date DATE);
CREATE TABLE
university=# CREATE TABLE books (
university(# book_id SERIAL PRIMARY KEY,
university(# title VARCHAR(200) NOT NULL,
university(# isbn VARCHAR(13) UNIQUE,
university(# publication_year INTEGER,
university(# available_copies INTEGER DEFAULT 1);
CREATE TABLE
university=# CREATE TABLE book_authors (
university(# book_id INTEGER,
university(# author_id INTEGER,
university(# PRIMARY KEY (book_id, author_id),
university(# FOREIGN KEY (book_id) REFERENCES books(book_id),
university(# FOREIGN KEY (author_id) REFERENCES authors(author_id));
CREATE TABLE
university=# CREATE TABLE members (
university(# member_id SERIAL PRIMARY KEY,
university(# first_name VARCHAR(50) NOT NULL,
university(# last_name VARCHAR(50) NOT NULL,
university(# email VARCHAR(100) UNIQUE NOT NULL,
university(# phone VARCHAR(15),
university(# membership_date DATE DEFAULT CURRENT_DATE);
CREATE TABLE
university=# CREATE TABLE loans (
university(# loan_id SERIAL PRIMARY KEY,
university(# member_id INTEGER NOT NULL,
university(# book_id INTEGER NOT NULL,
university(# loan_date DATE DEFAULT CURRENT_DATE,
university(# due_date DATE NOT NULL,
university(# return_date DATE,
university(# late_fee DECIMAL(10,2) DEFAULT 0.00,
university(# FOREIGN KEY (member_id) REFERENCES members(member_id),
university(# FOREIGN KEY (book_id) REFERENCES books(book_id));
CREATE TABLE
