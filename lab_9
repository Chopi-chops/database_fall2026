university=# -- Following 2NF:
university=# -- good- separate tables
university=# CREATE TABLE courses_2nf (
university(# course_id INT PRIMARY KEY,
university(# course_name VARCHAR(100),
university(# credits INT);
CREATE TABLE
university=# CREATE TABLE enrollments_2nf (
university(# student_id INT,
university(# course_id INT,
