university(# PRIMARY KEY (student_id, course_id),
university(# FOREIGN KEY (student_id) REFERENCES student_1nf(student_id),
university(# FOREIGN KEY (course_id) REFERENCES courses_2nf(course_id));
CREATE TABLE
