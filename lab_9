university=# -- First Normal Form
university=# -- (1NF)
university=# -- Each column contains atomic values
university=# -- no repeating groups or arrays
university=# -- each row is unique
university=# -- Violating 1NF:
university=# -- multiple phone numbers in 1 column
university=# CREATE TABLE student_bad (
university(# student_id INT PRIMARY KEY,
university(# name VARCHAR(100),
university(# phone_numbers TEXT);
CREATE TABLE
university=# INSERT INTO student_bad (student_id, name, phone_numbers) VALUES
university-# (1, 'Apple Jack', '123456, 234567');
INSERT 0 1
university=# SELECT * FROM student_bad;
 student_id |    name    | phone_numbers
------------+------------+----------------
          1 | Apple Jack | 123456, 234567
(1 row)


university=# -- Following 1NF:
university=# -- Good - atomic values
university=# CREATE TABLE student_1nf (
university(# student_id INT PRIMARY KEY,
university(# name VARCHAR(100));
CREATE TABLE
university=# CREATE TABLE student_phones (
university(# student_id INT,
university(# phone_number VARCHAR(20),
university(# phone_type VARCHAR(20),
university(# PRIMARY KEY (student_id, phone_number),
university(# FOREIGN KEY (student_id) REFERENCES student_1nf(student_id));
CREATE TABLE
university=# INSERT INTO student_1nf (student_id, name) VALUES
university-# (1, 'Apple Jack');
INSERT 0 1
university=# INSERT INTO student_phones (student_id, phone_number, phone_type) VALUES
university-# (1, '123456', 'Home'),
university-# (1, '234567', 'Work');
INSERT 0 2
university=# SELECT * FROM student_1nf;
 student_id |    name
------------+------------
          1 | Apple Jack
(1 row)


university=# SELECT * FROM student_phones;
 student_id | phone_number | phone_type
------------+--------------+------------
          1 | 123456       | Home
          1 | 234567       | Work
(2 rows)


